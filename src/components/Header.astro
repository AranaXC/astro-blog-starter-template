---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
  <nav aria-label="Primary navigation">
    <a class="brand" href="/" aria-label="8vista home">
      <span class="brand-mark">8</span>
      <span>{SITE_TITLE}</span>
    </a>
    <div class="internal-links">
      <HeaderLink href="/">首页</HeaderLink>
      <HeaderLink href="/blog">文章</HeaderLink>
      <HeaderLink href="/about">关于</HeaderLink>
      <a href="/admin/">后台</a>
    </div>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid rgba(var(--line), 70%);
    background: rgba(255, 255, 255, 88%);
    backdrop-filter: blur(16px);
  }

  nav {
    display: flex;
    width: min(1120px, calc(100% - 2rem));
    min-height: 72px;
    margin: 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: rgb(var(--ink));
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border: 1px solid rgba(15, 118, 110, 22%);
    border-radius: 8px;
    background: linear-gradient(135deg, #0f766e, #1f2937);
    color: #ffffff;
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .internal-links a {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    border-radius: 8px;
    padding: 0 0.85rem;
    color: rgb(var(--muted));
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .internal-links a:hover,
  .internal-links a.active {
    background: rgba(15, 118, 110, 10%);
    color: var(--accent-dark);
  }

  @media (max-width: 640px) {
    nav {
      min-height: auto;
      padding: 0.75rem 0;
      align-items: flex-start;
      flex-direction: column;
    }

    .internal-links {
      width: 100%;
      overflow-x: auto;
      padding-bottom: 0.1rem;
    }

    .internal-links a {
      flex: 0 0 auto;
    }
  }
</style>
