---
const today = new Date();
---

<footer>
  <div class="footer-inner">
    <div>
      <strong>8vista</strong>
      <p>发现、思考、分享，保留一个看世界的角度。</p>
    </div>
    <div class="footer-links">
      <a href="/blog">Blog</a>
      <a href="/about">About</a>
      <a href="/admin/">Admin</a>
    </div>
  </div>
  <p class="copyright">&copy; {today.getFullYear()} 8vista Lab. Personal notes only.</p>
</footer>

<style>
  footer {
    border-top: 1px solid rgba(var(--line), 80%);
    background: #ffffff;
    color: rgb(var(--muted));
  }

  .footer-inner {
    display: flex;
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2.5rem 0 1.5rem;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  strong {
    display: block;
    margin-bottom: 0.35rem;
    color: rgb(var(--ink));
    font-size: 1.1rem;
  }

  p {
    margin: 0;
    font-size: 0.95rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: flex-end;
  }

  .footer-links a {
    color: rgb(var(--muted));
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--accent-dark);
  }

  .copyright {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 0 0 2.5rem;
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
    }

    .footer-links {
      justify-content: flex-start;
    }
  }
</style>
