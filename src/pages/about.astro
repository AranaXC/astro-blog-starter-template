---
import { getEntry, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const about = await getEntry('site', 'about');
if (!about) {
  throw new Error('Missing src/content/site/about.md');
}
const { Content } = await render(about);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={about.data.title} description={about.data.description} image={about.data.heroImage} />
  </head>
  <body>
    <Header />
    <main class="about-page">
      <section class="about-hero">
        <p class="eyebrow">About</p>
        <h1>{about.data.title}</h1>
        <p>{about.data.description}</p>
      </section>
      <article class="prose">
        <Content />
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .about-page {
    max-width: 860px;
  }

  .about-hero {
    margin-bottom: 2rem;
    padding: 4rem 0 2rem;
  }

  .eyebrow {
    margin-bottom: 0.75rem;
    color: var(--accent-dark);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .about-hero p:last-child {
    max-width: 680px;
    color: rgb(var(--muted));
    font-size: 1.15rem;
  }

  .prose {
    padding: 2rem;
    border: 1px solid rgba(var(--line), 80%);
    border-radius: 8px;
    background: rgba(255, 255, 255, 78%);
  }

  @media (max-width: 640px) {
    .about-hero {
      padding-top: 2rem;
    }

    .prose {
      padding: 1.25rem;
    }
  }
</style>
