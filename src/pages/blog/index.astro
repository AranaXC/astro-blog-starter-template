---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="blog-hero">
        <p class="eyebrow">Blog</p>
        <h1>技术笔记与观察</h1>
        <p>关于网络基础设施、远程访问、自动化和个人工具链的记录。</p>
      </section>
      <section class="post-list">
        {posts.map((post) => (
          <article>
            {post.data.heroImage && <img width={360} height={220} src={post.data.heroImage} alt="" />}
            <div>
              <p class="date"><FormattedDate date={post.data.pubDate} /></p>
              <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
            </div>
          </article>
        ))}
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 980px;
  }

  .blog-hero {
    padding: 3rem 0 2rem;
  }

  .eyebrow,
  .date {
    margin-bottom: 0.75rem;
    color: var(--accent-dark);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .blog-hero p:last-child {
    max-width: 650px;
    color: rgb(var(--muted));
    font-size: 1.15rem;
  }

  .post-list {
    display: grid;
    gap: 1rem;
  }

  article {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 1.25rem;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid rgba(var(--line), 80%);
    border-radius: 8px;
    background: #ffffff;
  }

  article img {
    width: 100%;
    height: 100%;
    min-height: 180px;
    object-fit: cover;
    border-radius: 0;
  }

  article div {
    padding: 1.35rem 1.35rem 1.35rem 0;
  }

  h2 {
    margin-bottom: 0.55rem;
    font-size: 1.45rem;
  }

  h2 a {
    color: rgb(var(--ink));
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent-dark);
  }

  article p:last-child {
    margin: 0;
    color: rgb(var(--muted));
    font-size: 0.98rem;
  }

  @media (max-width: 720px) {
    article {
      grid-template-columns: 1fr;
    }

    article div {
      padding: 1.25rem;
    }
  }
</style>
