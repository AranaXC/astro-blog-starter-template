---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import home from '../data/home.json';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`${SITE_TITLE} | 无界世观`} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">{home.eyebrow}</p>
          <h1>{home.title}</h1>
          <p class="lead">{home.lead}</p>
          <p class="note">{home.note}</p>
          <div class="hero-actions">
            <a class="button primary" href={home.primaryAction.url}>{home.primaryAction.label}</a>
            <a class="button secondary" href={home.secondaryAction.url}>{home.secondaryAction.label}</a>
          </div>
        </div>
        <aside class="signal-panel" aria-label="8vista principles">
          {home.stats.map((item) => <div><span>{item.value}</span><p>{item.label}</p></div>)}
        </aside>
      </section>

      <section class="sections" aria-label="Site positioning">
        {home.sections.map((item) => (
          <article>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </section>

      <section class="latest">
        <div class="section-heading">
          <p class="eyebrow">Latest Notes</p>
          <h2>最新文章</h2>
          <a href="/blog">查看全部</a>
        </div>
        <div class="post-grid">
          {posts.map((post) => (
            <article class="post-card">
              {post.data.heroImage && <img src={post.data.heroImage} alt="" width="720" height="360" />}
              <div>
                <p class="date"><FormattedDate date={post.data.pubDate} /></p>
                <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .hero {
    display: grid;
    min-height: 560px;
    align-items: center;
    gap: 3rem;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
  }

  .eyebrow {
    margin-bottom: 0.9rem;
    color: var(--accent-dark);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 820px;
    margin-bottom: 1.25rem;
  }

  .lead {
    max-width: 690px;
    color: rgb(var(--ink));
    font-size: clamp(1.12rem, 2vw, 1.45rem);
  }

  .note {
    max-width: 660px;
    color: rgb(var(--muted));
    font-size: 1rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    border-radius: 8px;
    padding: 0 1.1rem;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
  }

  .button.primary {
    background: var(--accent);
    color: #ffffff;
    box-shadow: 0 12px 28px rgba(15, 118, 110, 24%);
  }

  .button.secondary {
    border: 1px solid rgba(var(--line), 90%);
    background: rgba(255, 255, 255, 70%);
    color: rgb(var(--ink));
  }

  .signal-panel {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid rgba(var(--line), 80%);
    border-radius: 8px;
    background: rgba(255, 255, 255, 75%);
    box-shadow: var(--box-shadow);
  }

  .signal-panel div {
    padding: 1.1rem;
    border-radius: 8px;
    background: var(--surface-soft);
  }

  .signal-panel span {
    color: var(--gold);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .signal-panel p {
    margin: 0.35rem 0 0;
    color: rgb(var(--ink));
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .sections,
  .post-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .sections article,
  .post-card {
    border: 1px solid rgba(var(--line), 80%);
    border-radius: 8px;
    background: var(--surface);
  }

  .sections article {
    padding: 1.4rem;
  }

  .sections h2 {
    font-size: 1.4rem;
  }

  .sections p,
  .post-card p {
    color: rgb(var(--muted));
    font-size: 0.98rem;
  }

  .latest {
    margin-top: 5rem;
  }

  .section-heading {
    display: flex;
    margin-bottom: 1.25rem;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .section-heading h2,
  .section-heading p {
    margin: 0;
  }

  .section-heading a {
    font-size: 0.95rem;
    font-weight: 700;
  }

  .post-card {
    overflow: hidden;
  }

  .post-card img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0;
  }

  .post-card div {
    padding: 1.15rem;
  }

  .post-card h3 {
    margin-bottom: 0.5rem;
    font-size: 1.15rem;
  }

  .post-card h3 a {
    color: rgb(var(--ink));
    text-decoration: none;
  }

  .post-card h3 a:hover {
    color: var(--accent-dark);
  }

  .date {
    margin-bottom: 0.5rem;
    color: var(--gold);
    font-size: 0.85rem;
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .hero,
    .sections,
    .post-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
      padding-top: 2rem;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
